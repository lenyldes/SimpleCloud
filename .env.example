# SimpleCloud Environment Variables Template
# Copy this file to .env before starting the application: cp .env.example .env

# App Server Configuration
PORT=32214
STORAGE_DIR=./data/storage

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=simplecloud
POSTGRES_USER=simplecloud_user
POSTGRES_PASSWORD=simplecloud_dev_password

# Default Storage Quota (5 GB in bytes)
DEFAULT_USER_QUOTA_BYTES=5368709120
